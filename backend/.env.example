NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://kadoos:kadoos@127.0.0.1:5432/kadoos?schema=public"
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="kadoos-dev-desk-secret"

# One Kadoos merchant. Guests pay this terminal; shops are paid via floating wages.
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX=true
KADOOS_FEE_PERCENT=10
# Must match a domain registered on the ZarinPal terminal (error -14 otherwise).
ZARINPAL_CALLBACK_URL="http://localhost:3000/{locale}/payments/callback"
# Dummy sandbox IBAN from ZarinPal docs — not a real account. Used only by prisma seed.
SEED_SHOP_IBAN="IR130570028780010957775103"
