generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id               String      @id @default(cuid())
  slug             String      @unique
  sortOrder        Int         @default(0)
  published        Boolean     @default(true)
  nameEn           String
  nameFa           String
  taglineEn        String
  taglineFa        String
  neighborhoodEn   String
  neighborhoodFa   String
  cityEn           String
  cityFa           String
  descriptionEn    String
  descriptionFa    String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  barbers          Barber[]
  services         Service[]
  hours            ShopHours[]
  appointments     Appointment[]
  owners           User[]

  @@index([published, sortOrder])
}

model Barber {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  nameEn    String
  nameFa    String
  titleEn   String
  titleFa   String
  bioEn     String
  bioFa     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appointments Appointment[]

  @@index([shopId, sortOrder])
}

model Service {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  nameEn      String
  nameFa      String
  durationMin Int
  priceToman  Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime      @updatedAt
  appointments Appointment[]

  @@index([shopId, sortOrder])
}

model ShopHours {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  weekday   Int
  closed    Boolean  @default(false)
  opensAt   String?
  closesAt  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, weekday])
}

enum UserRole {
  OWNER
}

enum AppointmentStatus {
  booked
  completed
  cancelled
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(OWNER)
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shopId])
}

model Appointment {
  id            String             @id @default(cuid())
  code          String             @unique
  shopId        String
  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barberId      String
  barber        Barber             @relation(fields: [barberId], references: [id], onDelete: Restrict)
  serviceId     String
  service       Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customerName  String
  customerPhone String
  startsAt      DateTime
  endsAt        DateTime
  status        AppointmentStatus  @default(booked)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([shopId, startsAt])
  @@index([barberId, startsAt])
  @@index([customerPhone])
  @@index([status, startsAt])
}
